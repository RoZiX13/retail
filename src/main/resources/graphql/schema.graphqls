type Country {
    countryId: ID!
    name: String!
    code: String
}

type City {
    cityId: ID!
    name: String!
}

type Category {
    categoryId: ID!
    name: String!
    parent: Category
    isActive: Boolean
}

type Unit {
    unitId: ID!
    fullName: String!
    shortName: String!
}

type Brand {
    brandId: ID!
    name: String!
    country: Country
    isActive: Boolean
}

type Product {
    productId: ID!
    sku: String!
    name: String!
    description: String
    unit: Unit!
    category: Category
    brand: Brand
    originCountry: Country
    isActive: Boolean
    createdAt: String
    currentStock(warehouseId: ID): Stock
    salePrices(shopId: ID): [SalePrice!]
}

type Stock {
    stockId: ID!
    product: Product!
    warehouse: Warehouse!
    quantity: Float!
    reservedQuantity: Float!
}

type Warehouse {
    warehouseId: ID!
    name: String!
    address: String
    city: City
    isActive: Boolean
    employees: [Employee!]
    stocks: [Stock!]
}

type Shop {
    shopId: ID!
    name: String!
    address: String
    city: City
    isActive: Boolean
    employees: [Employee!]
    sales: [Sale!]
}

type Supplier {
    supplierId: ID!
    name: String!
    inn: String
    kpp: String
    contactPerson: String
    phone: String
    email: String
    city: City
    address: String
    isActive: Boolean
}

type Customer {
    customerId: ID!
    firstName: String!
    patronymic: String
    lastName: String!
    phone: String
    email: String
    city: City
    address: String
    isActive: Boolean
    sales: [Sale!]
}

type Sale {
    saleId: ID!
    customer: Customer
    shop: Shop!
    employee: Employee
    saleDatetime: String!
    status: String!
    items: [SaleItem!]
}

type SaleItem {
    saleItemId: ID!
    product: Product!
    quantity: Float!
    unitPrice: Float!
    discountAmount: Float!
    finalPrice: Float!
}

type SalePrice {
    salePriceId: ID!
    product: Product!
    shop: Shop!
    priceValue: Float!
    discountAmount: Float!
    validFrom: String!
    validTo: String
}

type Employee {
    employeeId: ID!
    firstName: String!
    patronymic: String
    lastName: String!
    position: Position
    phone: String
    email: String
    manager: Employee
    shop: Shop
    warehouse: Warehouse
    isActive: Boolean
}

type Position {
    positionId: ID!
    name: String!
    employees: [Employee!]
}

# Queries
type Query {
    # Справочники
    countries(ids: [ID!]!): [Country!]!
    cities(ids: [ID!]!): [City!]!
    categories(ids: [ID!]!): [Category!]!
    units(ids: [ID!]!): [Unit!]!
    brands(ids: [ID!]!): [Brand!]!
    products(ids: [ID!]!): [Product!]!
    warehouses(ids: [ID!]!): [Warehouse!]!
    sales(ids: [ID!]!): [Sale!]!
    employees(ids: [ID!]!): [Employee!]!
    positions(ids: [ID!]!): [Position!]!
    products_by_filter(
        sku: String,
        categoryId: ID,
        brandId: ID,
        isActive: Boolean
    ): [Product!]
    sales_by_shop_id_and_customer_id(shopId: ID, customerId: ID): [Sale!]
    stocks(warehouseId: ID, productId: ID): [Stock!]
    suppliers(ids: [ID!]!): [Supplier!]!
    customers(ids: [ID!]!): [Customer!]!
    suppliers_by_active(active: Boolean): [Supplier!]
    customers_by_active(active: Boolean): [Customer!]
}

# Дополнение к Mutation и определения входных типов на основе Query

# ============================================
# Mutation
# ============================================

type Mutation {
    # Продукты
    createProduct(input: ProductInput!): Product
    updateProduct(id: ID!, input: ProductInput!): Product
    deleteProduct(id: ID!): Boolean

    # Продажи
    createSale(input: SaleInput!): Sale
    deleteSale(id: ID!): Boolean

    # Движение товаров (склад)
    createStockMovement(input: StockMovementInput!): Stock

    # Категории
    createCategory(input: CategoryInput!): Category
    updateCategory(id: ID!, input: CategoryInput!): Category
    deleteCategory(id: ID!): Boolean

    # Бренды
    createBrand(input: BrandInput!): Brand
    updateBrand(id: ID!, input: BrandInput!): Brand
    deleteBrand(id: ID!): Boolean

    # Единицы измерения
    createUnit(input: UnitInput!): Unit
    updateUnit(id: ID!, input: UnitInput!): Unit
    deleteUnit(id: ID!): Boolean

    # Склады
    createWarehouse(input: WarehouseInput!): Warehouse
    updateWarehouse(id: ID!, input: WarehouseInput!): Warehouse
    deleteWarehouse(id: ID!): Boolean

    # Сотрудники
    createEmployee(input: EmployeeInput!): Employee
    updateEmployee(id: ID!, input: EmployeeInput!): Employee
    deleteEmployee(id: ID!): Boolean

    # Должности
    createPosition(input: PositionInput!): Position
    updatePosition(id: ID!, input: PositionInput!): Position
    deletePosition(id: ID!): Boolean

    # Поставщики
    createSupplier(input: SupplierInput!): Supplier
    updateSupplier(id: ID!, input: SupplierInput!): Supplier
    deleteSupplier(id: ID!): Boolean

    # Клиенты
    createCustomer(input: CustomerInput!): Customer
    updateCustomer(id: ID!, input: CustomerInput!): Customer
    deleteCustomer(id: ID!): Boolean

    # Города
    createCity(input: CityInput!): City
    updateCity(id: ID!, input: CityInput!): City
    deleteCity(id: ID!): Boolean

    # Страны
    createCountry(input: CountryInput!): Country
    updateCountry(id: ID!, input: CountryInput!): Country
    deleteCountry(id: ID!): Boolean
}

# ============================================
# Входные типы (Input Types)
# ============================================

input ProductInput {
    sku: String!
    name: String!
    description: String
    categoryId: ID
    brandId: ID
    unitId: ID
    isActive: Boolean
    price: Float
}

input SaleInput {
    shopId: ID!
    customerId: ID
    employeeId: ID!
    saleDate: String!
    items: [SaleItemInput!]!
    status: String
}

input SaleItemInput {
    productId: ID!
    quantity: Int!
}

enum ChangeType {
    IN
    OUT
    RESERVE
    RELEASE
    ADJUST
    RETURN
}

enum ReferenceType {
    PURCHASE
    SALE
    RETURN
    MANUAL
}

input StockMovementInput {
    productId: Int!
    warehouseId: Int!
    quantity: Float!
    type: ChangeType!
    referenceType: ReferenceType!
}

input CategoryInput {
    name: String!
    description: String
    parentId: ID
}

input BrandInput {
    name: String!
    description: String
    countryId: ID
}

input UnitInput {
    name: String!
    symbol: String
}

input WarehouseInput {
    name: String!
    address: String
    cityId: ID
    isActive: Boolean
}

input EmployeeInput {
    firstName: String!
    lastName: String!
    positionId: ID!
    email: String
    phone: String
}

input PositionInput {
    title: String!
}

input SupplierInput {
    name: String!
    contactPerson: String
    phone: String
    email: String
    address: String
    isActive: Boolean
}

input CustomerInput {
    firstName: String!
    lastName: String!
    email: String
    phone: String
    address: String
    isActive: Boolean
}

input CityInput {
    name: String!
    countryId: ID!
    region: String
}

input CountryInput {
    name: String!
    code: String!
}